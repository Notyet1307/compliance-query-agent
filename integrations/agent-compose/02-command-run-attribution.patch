+	"github.com/chaitin/agent-compose/pkg/execution"
+	domain "github.com/chaitin/agent-compose/pkg/model"
+)
+
+// ConfigStore imports runs. This test-only bridge lets the external regression
+// use real SQLite and proxy packages without a circular production dependency.
+func IsolateCommandFacadeEnvForTest(t *testing.T) { isolatePromptAttachLLMEnv(t) }
+
+func ExecuteProjectCommandFacadeForTest(ctx context.Context, c *Controller, run domain.ProjectRunRecord, sandbox *domain.Sandbox, request RunAgentRequest, attached bool) (TransitionRequest, error) {
+	if !attached {
+		return c.executeProjectRunCommand(ctx, projectRunCommandExecution{Run: run, Sandbox: sandbox, Request: request, CommandText: request.Command})
+	}
+	if _, err := c.interactiveSessions.Create(run.RunID); err != nil {
+		return TransitionRequest{}, err
+	}
+	return c.runCommandInteraction(ctx, interactionRunContext{Run: run, Sandbox: sandbox, Request: request}, RunAttachInput{}, func() (RunAttachInput, error) { return RunAttachInput{}, io.EOF }, func(RunAttachOutput) error { return nil })
+}
+
+// Replace only the runtime adapter; preserve actual serialized child-env
+// precedence before the regression sends an authenticated facade request.
+type CommandFacadeRuntimeForTest struct {
+	guestFileControllerRuntime
+	Invoke            func(map[string]string)
+	ExecErr, SetupErr error
+}
+
+func (r *CommandFacadeRuntimeForTest) WriteGuestFile(ctx context.Context, sandbox *domain.Sandbox, state domain.VMState, path string, content []byte) error {
+	if r.SetupErr != nil {
+		return r.SetupErr
+	}
+	return r.guestFileControllerRuntime.WriteGuestFile(ctx, sandbox, state, path, content)
+}
+
+func (r *CommandFacadeRuntimeForTest) ExecStream(ctx context.Context, sandbox *domain.Sandbox, state domain.VMState, spec domain.ExecSpec, writer domain.ExecStreamWriter) (domain.ExecResult, error) {
+	r.execStarted = true
+	var request execution.RuntimeCommandRequest
+	if err := json.Unmarshal(r.writtenData, &request); err != nil {
+		return domain.ExecResult{}, err
+	}
+	env := execution.BuildSandboxExecEnv(&appconfig.Config{}, sandbox, "")
+	for k, v := range spec.Env {
+		env[k] = v
+	}
+	for k, v := range request.Env {
+		env[k] = v
+	}
+	r.Invoke(env)
+	result, err := r.fakeControllerRuntime.ExecStream(ctx, sandbox, state, spec, writer)
+	return result, errors.Join(err, r.ExecErr)
+}
+
+func (r *CommandFacadeRuntimeForTest) OpenInteraction(_ context.Context, sandbox *domain.Sandbox, _ domain.VMState, spec driverpkg.RuntimeStartSpec) (driverpkg.RuntimeInteraction, error) {
+	if r.SetupErr != nil {
+		return nil, r.SetupErr
+	}
+	env := execution.BuildSandboxExecEnv(&appconfig.Config{}, sandbox, "")
+	for k, v := range spec.Env {
+		env[k] = v
+	}
+	for k, v := range spec.Command.Env {
+		env[k] = v
+	}
+	r.Invoke(env)
+	interaction := newScriptedRunAttachInteraction()
+	if r.ExecErr != nil {
+		interaction.frames <- driverpkg.RuntimeOutputFrame{Type: driverpkg.RuntimeOutputError, Error: &driverpkg.RuntimeError{Message: r.ExecErr.Error()}}
+	}
+	interaction.frames <- driverpkg.RuntimeOutputFrame{Type: driverpkg.RuntimeOutputResult, Result: &driverpkg.RuntimeResult{Success: true}}
+	close(interaction.frames)
+	return &commandFacadeWaitForTest{scriptedRunAttachInteraction: interaction, err: r.ExecErr}, nil
+}
+
+type commandFacadeWaitForTest struct {
+	*scriptedRunAttachInteraction
+	err error
+}
+
+func (i *commandFacadeWaitForTest) Wait() (driverpkg.RuntimeResult, error) {
+	return driverpkg.RuntimeResult{Success: i.err == nil}, i.err
+}
