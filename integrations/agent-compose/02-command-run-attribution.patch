+package runs
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+
+	driverpkg "github.com/chaitin/agent-compose/pkg/driver"
+	"github.com/chaitin/agent-compose/pkg/llms/runtimefacade"
+	domain "github.com/chaitin/agent-compose/pkg/model"
+)
+
+func (c *Controller) prepareProjectCommandFacade(ctx context.Context, run domain.ProjectRunRecord, sandbox *domain.Sandbox) (runtimefacade.CommandFacadeConfig, error) {
+	store, ok := c.configDB.(runtimefacade.CommandFacadeStore)
+	if !ok || c.config == nil || sandbox == nil {
+		return runtimefacade.CommandFacadeConfig{}, nil
+	}
+	if strings.TrimSpace(run.RunID) == "" {
+		return runtimefacade.CommandFacadeConfig{}, fmt.Errorf("command facade requires a native run ID")
+	}
