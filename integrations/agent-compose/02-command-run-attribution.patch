+
+func (c *Controller) retireProjectCommandFacade(ctx context.Context, hashes []string, executionErr error) error {
+	if len(hashes) == 0 || errors.Is(executionErr, domain.ErrExecTerminationUnconfirmed) || errors.Is(executionErr, driverpkg.ErrExecTerminationUnconfirmed) {
+		return nil
+	}
+	store := c.configDB.(runtimefacade.CommandFacadeStore)
+	cleanupCtx := context.WithoutCancel(ctx)
+	var cleanupErr error
+	for _, hash := range hashes {
+		if err := store.DeleteLLMFacadeTokenHash(cleanupCtx, hash); err != nil {
+			cleanupErr = errors.Join(cleanupErr, fmt.Errorf("delete command facade token: %w", err))
+		}
+	}
+	return cleanupErr
+}
