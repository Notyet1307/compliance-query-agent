+func observedFacade(upstream, wire string) *echo.Echo {
+	e := echo.New()
+	RegisterRuntimeLLMFacadeRoutes(e, RuntimeLLMOptions{
+		Tokens:    fakeRuntimeLLMTokens{token: llms.FacadeToken{SandboxID: "sandbox-1", RunID: "run-1", ProviderID: "baizhi", WireAPI: wire}},
+		Sandboxes: fakeRuntimeLLMSessions{session: &domain.Sandbox{Summary: domain.SandboxSummary{ID: "sandbox-1", VMStatus: domain.VMStatusRunning}}},
+		ResolveTarget: func(context.Context, string, string) (llms.ResolvedTarget, error) {
+			return llms.ResolvedTarget{Provider: llms.Provider{ID: "baizhi", ProviderType: llms.ProviderFamilyOpenAI, BaseURL: upstream + "/v1"}, Model: llms.Model{Name: "grok-4.6"}, WireAPI: llms.APIProtocolChatCompletions, Headers: http.Header{"Authorization": {"Bearer synthetic-provider-secret"}}}, nil
+		},
+	}) // Exercise the secured default as well as the daemon's factory.
+	return e
+}
+
+func observationSnapshot(t *testing.T, e *echo.Echo) runtimeLLMCounters {
+	t.Helper()
+	r := httptest.NewRecorder()
+	e.ServeHTTP(r, httptest.NewRequest(http.MethodGet, "/api/llm/facade/observations", nil))
+	if r.Code != 200 || r.Header().Get("Cache-Control") != "no-store" {
+		t.Fatalf("snapshot status=%d headers=%v", r.Code, r.Header())
+	}
+	var counts runtimeLLMCounters
+	if err := json.Unmarshal(r.Body.Bytes(), &counts); err != nil {
+		t.Fatal(err)
+	}
+	return counts
+}
+
+func observedRequest(e *echo.Echo, path, body, token string, ctx context.Context) int {
+	r := httptest.NewRequest(http.MethodPost, "/api/runtime/sandboxes/sandbox-1/llm/openai/v1/"+path, strings.NewReader(body)).WithContext(ctx)
+	if token != "" {
+		r.Header.Set("Authorization", "Bearer "+token)
+	}
+	r.Header.Set("Content-Type", "application/json")
+	w := httptest.NewRecorder()
+	e.ServeHTTP(w, r)
+	return w.Code
