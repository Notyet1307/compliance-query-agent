+type observationLog struct {
+	mu sync.Mutex
+	bytes.Buffer
+}
+
+func (b *observationLog) Write(p []byte) (int, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.Buffer.Write(p)
+}
+func (b *observationLog) text() string { b.mu.Lock(); defer b.mu.Unlock(); return b.Buffer.String() }
