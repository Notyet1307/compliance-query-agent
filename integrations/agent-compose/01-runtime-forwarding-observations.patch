+func TestRuntimeLLMObservedForwarding(t *testing.T) {
+	var audit observationLog
+	previous := slog.Default()
+	slog.SetDefault(slog.New(slog.NewJSONHandler(&audit, nil)))
+	defer slog.SetDefault(previous)
+	for _, wire := range []string{llms.APIProtocolChatCompletions, llms.APIProtocolResponses} {
+		t.Run(wire, func(t *testing.T) {
+			var received atomic.Int32
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				received.Add(1)
+				body, err := io.ReadAll(r.Body)
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				if r.URL.Path != "/v1/chat/completions" {
+					t.Errorf("unexpected path %s", r.URL.Path)
+				}
+				if wire == llms.APIProtocolChatCompletions {
+					var actual, expected map[string]any
+					if err := json.Unmarshal(body, &actual); err != nil {
+						t.Error(err)
+					}
+					json.Unmarshal([]byte(observationChatBody), &expected)
+					if !reflect.DeepEqual(actual, expected) {
+						t.Errorf("Chat envelope changed: %s", body)
+					}
+				}
+				w.Header().Set("Content-Type", "application/json")
+				io.WriteString(w, observationChatResponse)
+			}))
+			defer upstream.Close()
+			e := observedFacade(upstream.URL, wire)
+			baseline := observationSnapshot(t, e)
+			if baseline.Ingress != 0 || baseline.Attempts != 0 || baseline.RequestWrites != 0 {
+				t.Fatalf("registration counted as use: %+v", baseline)
+			}
+			path, body := "chat/completions", observationChatBody
+			if wire == llms.APIProtocolResponses {
+				path, body = "responses", `{"model":"grok-4.6","input":"synthetic-private-body"}`
+			}
+			if status := observedRequest(e, path, body, "synthetic-facade-secret", context.Background()); status != 200 {
+				t.Fatalf("status=%d", status)
+			}
+			after := observationSnapshot(t, e)
+			if received.Load() != 1 || after.Ingress != 1 || after.Accepted != 1 || after.Attempts != 1 || after.RequestWrites != 1 || after.ResponseHeaders != 1 || after.Finished != 1 || after.Active != 0 || after.UnknownOutcomes != 0 || after.UnobservedWrites != 0 || after.WriteErrors != 0 || after.AuditErrors != 0 {
+				t.Fatalf("receiver=%d snapshot=%+v", received.Load(), after)
+			}
+			if next := observationSnapshot(t, e); next != after {
+				t.Fatalf("no request changed counters: %+v -> %+v", after, next)
+			}
+			if other := observationSnapshot(t, observedFacade(upstream.URL, wire)); other.Epoch == after.Epoch {
+				t.Fatal("new registration reused epoch")
+			}
+			if status := observedRequest(e, path, body, "", context.Background()); status != 401 {
+				t.Fatalf("missing token status=%d", status)
+			}
+			if status := observedRequest(e, path, `{"model":`, "synthetic-facade-secret", context.Background()); status < 400 {
+				t.Fatalf("malformed body status=%d", status)
+			}
+			denied := observationSnapshot(t, e)
+			if denied.Ingress != 3 || denied.Accepted != 1 || denied.Attempts != 1 || denied.RequestWrites != 1 || received.Load() != 1 || denied.Active != 0 {
+				t.Fatalf("denied/malformed forwarded: %+v", denied)
+			}
+		})
+	}
+	text := audit.text()
+	for _, secret := range []string{"synthetic-private-body", "synthetic-private-response", "synthetic-provider-secret", "synthetic-facade-secret"} {
+		if strings.Contains(text, secret) {
+			t.Fatalf("sensitive content in audit: %s", secret)
+		}
+	}
+	seen := map[string]map[string]bool{}
+	for _, line := range strings.Split(strings.TrimSpace(text), "\n") {
+		var row map[string]any
+		if err := json.Unmarshal([]byte(line), &row); err != nil {
+			t.Fatal(err)
+		}
+		if row["event"] == "request_written" {
+			if row["sandbox_id"] != "sandbox-1" || row["run_id"] != "run-1" || row["provider_id"] != "baizhi" || row["upstream_wire_api"] == "" {
+				t.Fatalf("lost forwarding correlation: %v", row)
+			}
+		}
+		id, _ := row["request_id"].(string)
+		event, _ := row["event"].(string)
+		if id == "" {
+			t.Fatal("missing server-generated request id")
+		}
+		if seen[id] == nil {
+			seen[id] = map[string]bool{}
+		}
+		seen[id][event] = true
+	}
+	for id, events := range seen {
+		if events["request_written"] && (!events["ingress"] || !events["accepted"] || !events["attempt"] || !events["response_headers"] || !events["finished"]) {
+			t.Fatalf("incomplete correlation %s: %v", id, events)
+		}
+	}
+}
