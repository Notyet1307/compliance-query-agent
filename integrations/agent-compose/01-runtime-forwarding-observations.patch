+package proxy
+
+import (
+	"context"
+	"io"
+	"log/slog"
+	"net/http"
+	"net/http/httptrace"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/labstack/echo/v4"
+)
+
+// Counts are process-local, monotonic and global to this facade registration.
+// Compare snapshots only within one epoch. Writes mean successful HTTP request
+// writes, NOT provider execution or billing. Unknown/unobserved work is not zero.
+type runtimeLLMCounters struct {
+	Epoch            string `json:"epoch"`
+	Sequence         uint64 `json:"sequence"`
+	Ingress          uint64 `json:"ingress"`
+	Accepted         uint64 `json:"accepted"`
+	Attempts         uint64 `json:"attempts"`
+	RequestWrites    uint64 `json:"request_writes"`
+	WriteErrors      uint64 `json:"write_errors"`
+	ResponseHeaders  uint64 `json:"response_headers"`
+	UnknownOutcomes  uint64 `json:"unknown_outcomes"`
+	UnobservedWrites uint64 `json:"unobserved_writes"`
+	Finished         uint64 `json:"finished"`
+	Active           uint64 `json:"active"`
+	AuditErrors      uint64 `json:"audit_errors"`
+}
+
+type runtimeLLMObservations struct {
+	// ponytail: one short lock orders counters and audit records; revisit only
+	// if the audit sink becomes a throughput bottleneck. Never hold across I/O
+	// to the provider, and never keep an unbounded per-run counter map.
+	mu     sync.Mutex
+	counts runtimeLLMCounters
+}
+
+type runtimeLLMObservation struct {
+	owner                                                      *runtimeLLMObservations
+	id, sandboxID, runID, providerID, wireAPI, upstreamWireAPI string
+	attempted                                                  bool // guarded by owner.mu, including httptrace callbacks
+	writeEvents                                                uint64
+}
+
+func (s *runtimeLLMObservations) snapshot(c echo.Context) error {
+	s.mu.Lock()
+	counts := s.counts
+	s.mu.Unlock()
+	c.Response().Header().Set("Cache-Control", "no-store")
+	return c.JSON(http.StatusOK, counts)
+}
+
+func (s *runtimeLLMObservations) start(wireAPI string) *runtimeLLMObservation {
+	o := &runtimeLLMObservation{owner: s, id: uuid.NewString(), wireAPI: wireAPI}
+	o.record("ingress", 0)
+	return o
+}
+
+func (o *runtimeLLMObservation) record(event string, status int) {
+	s := o.owner
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.counts.Sequence++
+	switch event {
+	case "ingress":
+		s.counts.Ingress++
+		s.counts.Active++
+	case "accepted":
+		s.counts.Accepted++
+	case "attempt":
+		s.counts.Attempts++
+		o.attempted = true
+	case "request_written":
+		s.counts.RequestWrites++
+		o.writeEvents++
+	case "write_error":
+		s.counts.WriteErrors++
+		o.writeEvents++
+	case "response_headers":
+		s.counts.ResponseHeaders++
+	case "unknown":
+		s.counts.UnknownOutcomes++
+	case "write_unobserved":
+		s.counts.UnobservedWrites++
+	case "finished":
+		s.counts.Finished++
+		s.counts.Active--
+	}
+	// No URL, model supplied by the caller, token/fingerprint, request/response
+	// payload, header or raw error. Correlation comes from the validated token.
+	logger := slog.Default()
+	ctx := context.Background()
+	if !logger.Enabled(ctx, slog.LevelInfo) {
+		s.counts.AuditErrors++
+		return
+	}
+	record := slog.NewRecord(time.Now(), slog.LevelInfo, "runtime_llm_observation", 0)
+	record.AddAttrs(slog.String("epoch", s.counts.Epoch), slog.Uint64("sequence", s.counts.Sequence),
+		slog.String("event", event), slog.String("request_id", o.id),
+		slog.String("sandbox_id", o.sandboxID), slog.String("run_id", o.runID),
+		slog.String("provider_id", o.providerID), slog.String("wire_api", o.wireAPI),
+		slog.String("upstream_wire_api", o.upstreamWireAPI),
+		slog.Int("upstream_status", status))
+	if err := logger.Handler().Handle(ctx, record); err != nil {
+		s.counts.AuditErrors++
+	}
+}
+
+func (o *runtimeLLMObservation) finish() {
+	o.owner.mu.Lock()
+	missing := o.attempted && o.writeEvents == 0
+	o.owner.mu.Unlock()
+	if missing {
+		// Custom transports may omit httptrace; callbacks may also arrive late.
+		// Keep the uncertainty even if a later callback supplies more evidence.
+		o.record("write_unobserved", 0)
+	}
+	o.record("finished", 0)
+}
+
+// Both the transparent and protocol-bridge paths pass through this boundary.
+func (h runtimeLLMHandler) forward(req *http.Request, o *runtimeLLMObservation) (*http.Response, error) {
+	trace := &httptrace.ClientTrace{WroteRequest: func(info httptrace.WroteRequestInfo) {
+		if info.Err != nil {
+			o.record("write_error", 0)
+		} else {
+			o.record("request_written", 0)
+		}
+	}}
+	req = req.WithContext(httptrace.WithClientTrace(req.Context(), trace))
+	o.record("attempt", 0)
+	response, err := h.httpClient().Do(req)
+	if err != nil {
+		o.record("unknown", 0)
+	} else {
+		// This is receipt of headers, not proof of a complete response body.
+		o.record("response_headers", response.StatusCode)
+		response.Body = &runtimeLLMResponseBody{ReadCloser: response.Body, observation: o}
+	}
+	return response, err
+}
+
+type runtimeLLMResponseBody struct {
+	io.ReadCloser
+	observation *runtimeLLMObservation
+	readError   sync.Once
+	sawEOF      atomic.Bool
+}
+
+func (b *runtimeLLMResponseBody) Read(p []byte) (int, error) {
+	n, err := b.ReadCloser.Read(p)
+	if err == io.EOF {
+		b.sawEOF.Store(true)
+	} else if err != nil {
+		b.readError.Do(func() { b.observation.record("unknown", 0) })
+	}
+	return n, err
+}
+
+func (b *runtimeLLMResponseBody) Close() error {
+	// A synthetic EOF from a limit or a downstream write failure must not
+	// imply that the upstream response completed. Close also unblocks Read.
+	err := b.ReadCloser.Close()
+	if !b.sawEOF.Load() {
+		b.readError.Do(func() { b.observation.record("unknown", 0) })
+	}
+	return err
+}
