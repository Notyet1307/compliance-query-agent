+func TestRuntimeLLMObservedConcurrentRequests(t *testing.T) {
+	entered := make(chan struct{}, 8)
+	release := make(chan struct{})
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		io.Copy(io.Discard, r.Body)
+		entered <- struct{}{}
+		<-release
+		w.Header().Set("Content-Type", "application/json")
+		io.WriteString(w, observationChatResponse)
+	}))
+	defer upstream.Close()
+	e := observedFacade(upstream.URL, llms.APIProtocolChatCompletions)
+	statuses := make(chan int, 8)
+	for i := 0; i < 8; i++ {
+		go func() {
+			statuses <- observedRequest(e, "chat/completions", observationChatBody, "fixture", context.Background())
+		}()
+	}
+	for i := 0; i < 8; i++ {
+		select {
+		case <-entered:
+		case <-time.After(5 * time.Second):
+			close(release)
+			t.Fatal("requests did not reach controlled upstream")
+		}
+	}
+	active := observationSnapshot(t, e)
+	close(release)
+	if active.Active != 8 || active.Attempts != 8 || active.ResponseHeaders != 0 {
+		t.Fatalf("lost active work: %+v", active)
+	}
+	for i := 0; i < 8; i++ {
+		if status := <-statuses; status != 200 {
+			t.Fatalf("status=%d", status)
+		}
+	}
+	final := observationSnapshot(t, e)
+	if final.Ingress != 8 || final.Attempts != 8 || final.RequestWrites != 8 || final.ResponseHeaders != 8 || final.Finished != 8 || final.Active != 0 {
+		t.Fatalf("lost concurrent counters: %+v", final)
+	}
+}
