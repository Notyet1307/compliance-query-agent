+	}
+	response, err := h.forward(request, o)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Exercise the same synthetic EOF as the handler's64MiB LimitReader,
+	// without keeping a64MiB fixture/allocation in the regression suite.
+	body, err := io.ReadAll(io.LimitReader(response.Body, 1))
+	if err != nil || string(body) != "a" {
+		t.Fatalf("limited read: %q %v", body, err)
+	}
+	response.Body.Close()
+	response.Body.Close() // Repeated close must not count one outcome twice.
+	o.finish()
+	e := echo.New()
+	e.GET("/api/llm/facade/observations", s.snapshot)
+	counts := observationSnapshot(t, e)
+	if counts.RequestWrites != 1 || counts.UnknownOutcomes != 1 || counts.Active != 0 {
+		t.Fatalf("synthetic EOF concealed unconsumed response: %+v", counts)
+	}
