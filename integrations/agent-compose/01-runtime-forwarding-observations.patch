+func TestRuntimeLLMRejectsRedirects(t *testing.T) {
+	var escaped atomic.Int32
+	sink := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		escaped.Add(1)
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer sink.Close()
+	origin := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		io.Copy(io.Discard, r.Body)
+		http.Redirect(w, r, sink.URL, http.StatusTemporaryRedirect)
+	}))
+	defer origin.Close()
+	client := NewRuntimeLLMHTTPClient(time.Second)
+	defer client.CloseIdleConnections()
+	response, err := client.Post(origin.URL, "application/json", strings.NewReader(`{"synthetic":true}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	response.Body.Close()
+	if response.StatusCode != http.StatusTemporaryRedirect || escaped.Load() != 0 {
+		t.Fatalf("status=%d redirected requests=%d; redirect must be returned without forwarding", response.StatusCode, escaped.Load())
+	}
+}
