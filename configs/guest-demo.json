{
  "schemaVersion": "cqa.config/v1",
  "storeDir": "/tmp/cqa/receipts",
  "allowSynthetic": true,
  "networkApproved": false,
  "timeoutSeconds": 30,
  "knowledge": {
    "mode": "local",
    "corpusPath": "/opt/cqa/testdata/demo-corpus.json"
  },
  "generation": {
    "mode": "extractive"
  },
  "server": {
    "listen": "127.0.0.1:8088",
    "tokenEnv": "CQA_API_TOKEN"
  }
}
