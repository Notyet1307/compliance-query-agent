{
  "schemaVersion": "cqa.config/v1",
  "storeDir": "../.local/live-receipts",
  "allowSynthetic": false,
  "networkApproved": false,
  "timeoutSeconds": 30,
  "knowledge": {
    "mode": "octobus_connect",
    "endpoint": "https://octobus.example.invalid/capsets/compliance-readonly/connect/compliance-kb/compliance.v1.KnowledgeService/Search",
    "tokenEnv": "CQA_OCTOBUS_TOKEN"
  },
  "generation": {
    "mode": "llm",
    "endpoint": "https://ai-api-gateway.app.baizhi.cloud/api/openai/chat/completions",
    "model": "grok-4.6",
    "tokenEnv": "CQA_LLM_TOKEN"
  },
  "server": {
    "listen": "127.0.0.1:8088",
    "tokenEnv": "CQA_API_TOKEN"
  }
}
