{
  "schemaVersion": "cqa.config/v1",
  "storeDir": "../.local/s1-test-receipts",
  "allowSynthetic": true,
  "networkApproved": false,
  "timeoutSeconds": 30,
  "knowledge": {
    "mode": "local",
    "corpusPath": "../testdata/s1-test-document.json"
  },
  "generation": {
    "mode": "extractive"
  },
  "server": {
    "listen": "127.0.0.1:8088",
    "tokenEnv": "CQA_API_TOKEN"
  }
}
