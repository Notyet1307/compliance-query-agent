# Requires an operator-approved, digest-pinned agent-compose guest base.
# Deliberately no default latest image and no changed ENTRYPOINT/CMD.
ARG BASE_GUEST_IMAGE
FROM ${BASE_GUEST_IMAGE}
COPY --chmod=0555 bin/compliance-agent-guest /opt/cqa/compliance-agent
COPY configs/guest-demo.json /opt/cqa/configs/guest-demo.json
COPY testdata/demo-corpus.json /opt/cqa/testdata/demo-corpus.json
COPY examples/mlps.json /opt/cqa/examples/mlps.json
# This image is synthetic/offline only. Do not bake credentials or real corpora.
